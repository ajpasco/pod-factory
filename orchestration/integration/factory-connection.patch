+      { id: 'story-bytes-match', satisfied: boundStoryHash !== undefined && storyContent !== null && sha256Lf(storyContent) === boundStoryHash,
+        requirement: `${storyPath} on the trunk still hashes to what gate 3 bound.`,
+        observed: storyContent === null ? `${storyPath} is not on ${trunkCommit.slice(0, 12)}.` : boundStoryHash === undefined ? 'Nothing bound to compare against.' : sha256Lf(storyContent) === boundStoryHash ? 'Trunk bytes match the approved hash.' : `Trunk bytes hash to ${sha256Lf(storyContent).slice(0, 12)} but gate 3 bound ${boundStoryHash.slice(0, 12)}; the authorization is stale.` },
+    ];
+
+    const missing = prerequisites.filter(p => !p.satisfied);
+    const outcome: FactoryOutcome = missing.length === 0 ? 'ready' : missing.every(p => p.humanAction !== undefined) ? 'waiting-for-user' : 'blocked';
+    return { ...base, outcome, prerequisites,
+      summary: missing.length === 0
+        ? `The factory already authorizes ${story}: gate 2, its lock and gate 3 are active and bind the exact trunk bytes.`
+        : `${missing.length} of ${prerequisites.length} prerequisites are unmet, so ${story} cannot be dispatched: ${missing.map(p => p.id).join(', ')}.` };
+  }
+
+  /** Reads the route, decides, and refuses. This build submits nothing: see CLAUDE-STATUS.md. */
+  async requestDispatch(request: DispatchRequest, pkg: FactoryExportPackage): Promise<{ decision: DispatchDecision; entry?: DispatchLedgerEntry }> {
+    const state = await this.inspect(request.story);
+    const decision = evaluateDispatch({ state, pkg, request, ledger: this.options.ledger ?? [] });
+    if (!mayDispatch(decision)) return { decision, ...(decision.existing === undefined ? {} : { entry: decision.existing }) };
+    return { decision: { outcome: 'blocked', blockedBy: [],
+      reasons: ['Every records prerequisite is met, but this build has no submission path: the factory ships no dispatch command, so a builder is started by a person. Hand the authorized story to the dispatch step by hand and record its factory reference.'] } };
+  }
+
+  private cliVersion(): string | null {
+    const path = this.options.cliPackagePath;
+    if (path === undefined) return null;
+    try { return (JSON.parse(readFileSync(path, 'utf8')) as { version?: string }).version ?? null; } catch { return null; }
+  }
+}
+
+/** `**` spans slashes, `*` stays inside one segment. Mirrors the factory's own lock-policy glob. */
+export function globToRegExp(pattern: string): RegExp {
+  let source = '';
+  for (let i = 0; i < pattern.length; i++) {
+    const c = pattern[i];
+    if (c === '*' && pattern[i + 1] === '*') { source += '.*'; i++; }
+    else if (c === '*') { source += '[^/]*'; }
+    else { source += c.replace(/[.+?^${}()|[\]\\]/g, '\\$&'); }
+  }
+  return new RegExp(`^${source}$`);
+}
