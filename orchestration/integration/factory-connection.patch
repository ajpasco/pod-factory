+// Real read-only inspection of the actual factory. No fixture. It runs plain-reading git commands
+// against an existing checkout, writes no record, approves nothing and never fetches.
+// Run from orchestration/:  npm run build && node test/factory-real-route.mjs [repoPath]
+import { writeFileSync, mkdirSync } from 'node:fs';
+import { resolve } from 'node:path';
+import { RealFactoryRoute } from '../dist/src/factory.js';
+
+const repoPath = resolve(process.argv[2] ?? '..');
+const harnessRoot = 'docs/projects/equipment-checkout';
+const route = new RealFactoryRoute({ repoPath, harnessRoot, cliPackagePath: `${process.env.HOME}/.local/lib/node_modules/pod-factory/package.json` });
+
+// story-2 is a real story the live gate-3 approval binds; story-4 is the hypothetical next one the
+// equipment application would need. Both are read, so the output separates what is already
+// authorized from what this application still lacks.
+const observed = [];
+for (const story of ['story-2', 'story-4']) {
+  const state = await route.inspect(story);
+  observed.push({ story, outcome: state.outcome, summary: state.summary,
+    prerequisites: state.prerequisites.map(p => ({ id: p.id, satisfied: p.satisfied, observed: p.observed, ...(p.humanAction ? { humanAction: p.humanAction } : {}) })) });
+  console.log(`\n${story}: ${state.outcome}\n  ${state.summary}`);
+  for (const p of state.prerequisites) console.log(`  ${p.satisfied ? 'ok     ' : 'MISSING'} ${p.id}: ${p.observed}`);
+}
+
+const first = await route.inspect('story-2');
+const evidence = { recordedAt: new Date().toISOString(), kind: 'Real read-only factory inspection; no fixture, no write, no fetch',
+  repoPath, harnessRoot, factoryVersion: first.factoryVersion, recordsCommit: first.recordsCommit, trunkCommit: first.trunkCommit, observed };
+const out = resolve(import.meta.dirname, '../evidence/factory-route');
+mkdirSync(out, { recursive: true });
+writeFileSync(resolve(out, 'real-route.json'), JSON.stringify(evidence, null, 2) + '\n');
+console.log(`\nfactory ${first.factoryVersion}  records ${first.recordsCommit?.slice(0, 12)}  trunk ${first.trunkCommit?.slice(0, 12)}`);
+console.log(`Wrote ${resolve(out, 'real-route.json')}`);
+// A blocked or waiting outcome is the expected, correct answer today: exit 0 on a read that worked.
+process.exitCode = observed.every(o => ['ready', 'waiting-for-user', 'blocked'].includes(o.outcome)) ? 0 : 1;
