+  t.after(async () => { await new Promise<void>(done => server.close(() => done())); await rm(dataDir, { recursive: true, force: true }); });
+  const token = /content="([a-f0-9]{64})"/.exec(await (await fetch(`${origin}/`)).text())![1];
