+async function serve(t: { after(fn: () => Promise<void>): void }, factoryRoute?: FakeFactoryRoute) {
+  const dataDir = await mkdtemp(join(tmpdir(), 'factory-http-'));
+  const { server, service } = await createPreparationServer({ dataDir, workspacePath: dataDir, provider: draft, planningProvider, orcaTransport: { async targets() { return []; }, async verify(target) { return { target, state: 'ready' }; }, async send() { return { accepted: true, requestId: 'fixture', stage: 'input_accepted' }; }, async prepareSession(provider, preference) { return { state: 'uncertain', provider, preference, sessionId: 'f', createParams: {}, optionRequests: [], reason: 'fixture' }; }, async launchSession() { throw new Error('not used'); } }, providerLabel: 'test fixture', ...(factoryRoute === undefined ? {} : { factoryRoute }) });
