+import { describe, expect, it } from 'vitest';
+import {
+  effectiveLock,
+  gateCheck,
+  hashText,
+  loadRecords,
+  recordBase,
+  run,
+  shownHashOf,
+  validateRecord,
+  serializeRecord,
+  recordFileName,
+  type ApprovalRecord,
+  type FileBinding,
+} from '../src/index.js';
+import {
+  ciProject,
+  plantLock,
+  plantVerify,
+  treeAt,
+  ciCheck,
+  CONFIG,
+  CONFIG_V0,
+  CONFIG_V1,
+  TEST_COMMAND,
+} from './support/ci.js';
+import { confirms, human } from './support/project.js';
+import { HUMAN, SHA_A, revocation, stored } from './support/records.js';
+
+const PLAN = '.factory/work/plan/build-plan.md';
+const STORY = '.factory/work/story-4/story.md';
+const POLICY = 'packages/cli/src/lock-policy.ts';
+const CONTENT = {
+  [PLAN]: `# Equipment plan\n\n1. ${STORY}\n`,
+  [STORY]: '# Equipment story\n',
+  [POLICY]: 'export const policy = true;\n',
+  [CONFIG]: CONFIG_V1,
+};
+
+function setup(content: Record<string, string | null> = CONTENT) {
+  const f = ciProject();
+  const lock = plantLock(f);
+  const head = f.pullRequest(7, content);
+  const tree = treeAt(f, head);
+  const bindings: Record<string, FileBinding> = {};
+  for (const [path, value] of Object.entries(content)) {
+    bindings[path] = {
+      before: path === CONFIG ? hashText(CONFIG_V0) : null,
+      after: value === null ? null : hashText(value),
+    };
+  }
+  const make = (files = bindings): ApprovalRecord => {
+    const statement = 'Maintenance: explicitly authorize this exact reviewed PR/tree only.';
+    const binds = { tree, files };
+    const refs = [lock.recordId];
+    const shown = shownHashOf({ statement, binds, refs, maintenance: true, pullRequest: 7 });
+    return {
+      ...recordBase(HUMAN),
+      recordType: 'approval',
+      binds,
+      refs,
+      outcome: 'approved',
+      approval: {
+        kind: 'amendment',
+        gate: null,
+        story: null,
+        pullRequest: 7,
+        maintenance: true,
+        statement,
+        shownHash: shown,
+        typedPrefix: shown.slice(0, 8),
+      },
+    };
+  };
+  const plant = (record: ApprovalRecord) => f.plant(Object.fromEntries([stored(record)]));
+  return { f, lock, head, tree, make, plant };
+}
+
+function stateAt(c: ReturnType<typeof setup>) {
+  const state = effectiveLock(loadRecords(c.f.work));
+  if (state === null) throw new Error('fixture has no effective lock');
+  return state;
+}
+
+function lastAmendment(c: ReturnType<typeof setup>) {
+  const last = stateAt(c).amendments.at(-1);
+  if (last === undefined) throw new Error('fixture has no effective amendment');
+  return last.record;
+}
+
+function rehash(record: ApprovalRecord) {
+  const shown = shownHashOf({
+    statement: record.approval.statement,
+    binds: record.binds,
+    refs: record.refs,
+    maintenance: true,
+    pullRequest: record.approval.pullRequest as number,
+  });
+  record.approval.shownHash = shown;
+  record.approval.typedPrefix = shown.slice(0, 8);
+  return record;
+}
+
+const validate = (record: ApprovalRecord) =>
+  validateRecord(recordFileName(record, 'test'), serializeRecord(record));
+
+describe('exact-content maintenance amendments', () => {
+  it('explicit ceremony binds the full mixed diff without locking unlocked paths or approving execution', async () => {
+    const { f, lock, head, tree } = setup();
+    const io = human(f.work, confirms('amendment'));
+    expect(
+      await run(
+        ['approve', 'amendment', '--maintenance', '--pr', '7', ...Object.keys(CONTENT)],
+        io,
+      ),
+    ).toBe(0);
+    expect(io.lines.join('\n')).toMatch(/authorize merging pull request 7 ONLY at tree/);
+    expect(io.lines.join('\n')).toMatch(/gate 3 remains separate/);
+    const set = loadRecords(f.work);
+    const state = effectiveLock(set);
+    const record = state?.amendments.at(-1)?.record;
+    expect(record?.approval.maintenance).toBe(true);
+    expect(record?.binds.files[PLAN]).toEqual({ before: null, after: hashText(CONTENT[PLAN]) });
+    expect(state?.hashes.get(CONFIG)).toBe(hashText(CONFIG_V1));
+    for (const path of [PLAN, STORY, POLICY]) {
+      expect(state?.hashes.has(path)).toBe(false);
+      expect(state?.held.has(path)).toBe(false);
+    }
+    expect(state?.lock.record.lock).toEqual(lock.lock);
+    expect(state?.lock.record.lock.testCommands).toEqual([TEST_COMMAND]);
+    plantVerify(f, 7, tree);
+    expect(ciCheck(f, 'lock-guard', 7, head).status).toBe(0);
+    expect(ciCheck(f, 'gate-check', 7, head).status).toBe(0);
+    const builder = f.pullRequest(8, { 'src/equipment.js': 'export {};\n' });
+    plantVerify(f, 8, treeAt(f, builder));
+    expect(ciCheck(f, 'gate-check', 8, builder).status).toBe(1);
+    f.commitToMain(CONTENT, 'fixture-only maintenance merge');
+    const start = human(f.work);
+    expect(await run(['story', 'start', 'story-4', '--holder', 'builder'], start)).toBe(1);
+    expect(start.errors.join('\n')).toMatch(/gate.?3/i);
+  });
+
+  it('supports unlocked-only maintenance without contaminating lock state', () => {
+    const c = setup({ [PLAN]: CONTENT[PLAN], [STORY]: CONTENT[STORY] });
+    c.plant(c.make());
