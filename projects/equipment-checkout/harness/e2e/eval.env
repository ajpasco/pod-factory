# Frozen at the S4 freeze. Read-only to every builder, S4's own included.
#
# The six keys of the blueprint's settings table (TECH-SPEC section 6), with
# local test values. Command C10 and the production rows pass this file to
# `docker compose --env-file`, so these values, and not a developer's own `.env`,
# are what the stack under test is built and started from. That is the point of
# freezing it: a builder cannot point its own exam at a differently configured
# stack, and `.env` (git-ignored, the developer's real values) is never read by
# the eval sequence.
#
# `DATABASE_URL` names the host `db` and the port 5432 because it is read inside
# the Compose network by the `api` service, not from the developer's machine.
POSTGRES_USER=eval
POSTGRES_PASSWORD=eval-only
POSTGRES_DB=equipment
DATABASE_URL=postgresql+psycopg://eval:eval-only@db:5432/equipment
WEB_PORT=8080
VITE_API_BASE_URL=/api
